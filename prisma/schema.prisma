datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ─── Module 1: Utilisateurs (User) ──────────────────────────────────────────

model User {
  id                String    @id @default(uuid()) @db.Uuid
  firstName         String    @db.VarChar(100)
  lastName          String    @db.VarChar(100)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @db.VarChar(255)
  avatar            String?   @db.VarChar(500)
  bio               String?   @db.Text
  role              String    @db.VarChar(50)
  isVerified        Boolean
  lastLogin         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  restoreOtp        String?   @db.VarChar(255)
  restoreOtpExp     DateTime?
  phone             String?   @db.VarChar(50)
  passwordChangedAt DateTime?
  // Bumped on every login to enforce a single active session per account: a
  // token whose `tv` no longer matches is rejected, logging out the older device.
  tokenVersion      Int       @default(0)

  // Portfolio (learners & instructors) — validated/normalized in
  // src/utils/portfolioValidation.js. `certifications` is deliberately distinct
  // from the `certificates` relation below (platform course certificates).
  skills         Json? // string[]                          e.g. ["React","Node.js"]
  languages      Json? // [{ name, level }]                 level: basic|intermediate|fluent|native
  certifications Json? // [{ title, issuer, year, fileUrl }]
  diplomas       Json? // [{ title, institution, year, fileUrl }]
  socialLinks    Json? // { linkedin, github, website, twitter }

  // Relations
  coursesInstructed CourseInstructor[]
  enrollments       Enrollment[]
  cart              Cart?
  wishlist          Wishlist[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  lessonProgress    LessonProgress[]
  reviews           Review[]
  notifications     Notification[]
  badges            UserBadge[]
  certificates      Certificate[]
  auditLogs         AuditLog[]
  groupsTaught      Group[]               @relation("GroupFormateur")
  groupsCreated     Group[]               @relation("GroupCreator")
  groupMemberships  GroupStudent[]
  studentProfile    StudentProfile?
  instructorProfile InstructorProfile?
  updateRequests    CourseUpdateRequest[]
  reviewedRequests  CourseUpdateRequest[] @relation("CourseUpdateRequestReviewer")
  groupChatMessages GroupChatMessage[]
  packCourses       PackCourse[]          @relation("PackCourseInstructor")
  packPurchases     PackPurchase[]
  revenueShares     RevenueShare[]        @relation("RevenueShareInstructor")

  // Admin stats & user listings filter heavily on role + soft-delete state.
  @@index([role, deletedAt])
  @@index([deletedAt])
  @@index([phone])
  @@map("users")
}

// ─── Student Profile ───────────────────────────────────────────────────────────

model StudentProfile {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @db.Uuid
  situation         String    @default("student") @db.VarChar(50)
  school            String?   @db.VarChar(255)
  fieldOfStudy      String?   @db.VarChar(255)
  educationLevel    String?   @db.VarChar(50)
  academicYearStart DateTime?
  academicYearEnd   DateTime?
  companyName       String?   @db.VarChar(255)
  department        String?   @db.VarChar(255)
  position          String?   @db.VarChar(255)
  sector            String?   @db.VarChar(255)
  experienceYears   String?   @db.VarChar(10) // range token: <1, 1-2, 3-5, 6-10, >10
  interests         String?   @db.Text
  learningObjective String?   @db.Text
  currentLevel      String?   @db.VarChar(50)
  group             String?   @db.VarChar(50)
  isSelfDirected    Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}

// ─── Instructor Profile ────────────────────────────────────────────────────────

model InstructorProfile {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  situation       String   @default("employed") @db.VarChar(50)
  expertiseDomain String?  @db.VarChar(255) // "Domaine d'expertise" (e.g. Développement Web)
  specialization  String   @db.VarChar(255) // "Spécialité" (e.g. React & Node.js)
  organization    String?  @db.VarChar(255)
  department      String?  @db.VarChar(255)
  position        String?  @db.VarChar(255)
  sector          String?  @db.VarChar(255)
  experienceYears String   @db.VarChar(10) // range token: <1, 1-2, 3-5, 6-10, >10
  teachingMode    String   @db.VarChar(50)
  teachingDomains String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("instructor_profiles")
}

// ─── Module 2: Cours & Catalogue (Course) ────────────────────────────────────

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(150)
  description String?   @db.Text
  icon        String?   @db.VarChar(50)
  parentId    String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Self-relation
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryToCategory")

  // Relations
  courses          Course[]
  courseCategories CourseCategory[]

  @@map("categories")
}

model Course {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String    @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  price       Decimal   @db.Decimal(10, 2)
  level       String?   @db.VarChar(50)
  language    String?   @db.VarChar(50)
  duration    Int?
  status      String    @db.VarChar(50)
  thumbnail   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  category       Category              @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categories     CourseCategory[]
  instructors    CourseInstructor[]
  sections       Section[]
  enrollments    Enrollment[]
  cartItems      CartItem[]
  wishlists      Wishlist[]
  meetings       Meeting[]
  reviews        Review[]
  certificates   Certificate[]
  groups         Group[]
  updateRequests CourseUpdateRequest[]
  coupons        Coupon[]
  packCourses    PackCourse[]
  revenueShares  RevenueShare[]

  @@index([status, deletedAt])
  @@index([categoryId])
  @@map("courses")
}

model CourseInstructor {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  userId   String @db.Uuid
  role     String @db.VarChar(50)

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
  @@map("course_instructors")
}

// Additional categories a course belongs to (beyond its required primary
// categoryId). Lets a course be discoverable under several categories.
model CourseCategory {
  id         String @id @default(uuid()) @db.Uuid
  courseId   String @db.Uuid
  categoryId String @db.Uuid

  // Relations
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([courseId, categoryId])
  @@index([categoryId])
  @@map("course_categories")
}

// Course Update Request - for instructors to request changes to published courses
model CourseUpdateRequest {
  id              String    @id @default(uuid()) @db.Uuid
  courseId        String    @db.Uuid
  instructorId    String    @db.Uuid
  title           String?   @db.VarChar(255)
  description     String?   @db.Text
  price           Decimal?  @db.Decimal(10, 2)
  level           String?   @db.VarChar(50)
  thumbnail       String?   @db.VarChar(500)
  status          String    @default("PENDING") @db.VarChar(50) // 'PENDING', 'APPROVED', 'REJECTED'
  reviewedBy      String?   @db.Uuid
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  reviewer   User?  @relation("CourseUpdateRequestReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([instructorId])
  @@map("course_update_requests")
}

// ─── Module 3: Contenu Pédagogique (Content) ───────────────────────────────

model Section {
  id       String @id @default(uuid()) @db.Uuid
  courseId String @db.Uuid
  title    String @db.VarChar(255)
  position Int

  // Relations
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@map("sections")
}

model Lesson {
  id        String @id @default(uuid()) @db.Uuid
  sectionId String @db.Uuid
  title     String @db.VarChar(255)
  position  Int

  // Relations
  section        Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  resources      Resource[]
  assignments    Assignment[]
  quizzes        Quiz[]
  lessonProgress LessonProgress[]

  @@map("lessons")
}

model Resource {
  id       String @id @default(uuid()) @db.Uuid
  lessonId String @db.Uuid
  type     String @db.VarChar(50)
  url      String @db.VarChar(500)

  // Relations
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model Assignment {
  id          String    @id @default(uuid()) @db.Uuid
  lessonId    String    @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  dueDate     DateTime?

  // Relations
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@map("assignments")
}

model Submission {
  id           String   @id @default(uuid()) @db.Uuid
  assignmentId String   @db.Uuid
  userId       String   @db.Uuid
  fileUrl      String?  @db.VarChar(500)
  grade        Decimal? @db.Decimal(5, 2)
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now())

  // Relations
  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("submissions")
}

// ─── Module 4: Commerce (Commerce) ──────────────────────────────────────────

model Enrollment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  courseId   String   @db.Uuid
  enrolledAt DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payment Payment?

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model Payment {
  id                   String    @id @default(uuid()) @db.Uuid
  enrollmentId         String    @unique @db.Uuid
  amount               Decimal   @db.Decimal(10, 2)
  currency             String    @db.VarChar(10)
  provider             String    @db.VarChar(50)
  transactionReference String    @unique @db.VarChar(255)
  status               String    @db.VarChar(50) // 'PENDING', 'WAITING_VERIFICATION', 'PAID', 'REJECTED', 'REFUNDED'
  paidAt               DateTime?
  couponId             String?   @db.Uuid

  // Wafacash robust validation fields
  mtcn       String? @db.VarChar(50)
  receiptUrl String? @db.VarChar(500)

  // Bank Transfer (Virement) fields
  rib                String? @db.VarChar(50) // RIB submitted by user
  transferReceiptUrl String? @db.VarChar(500) // Transfer receipt image

  // Common verification fields
  verifiedBy String?   @db.Uuid
  verifiedAt DateTime?
  notes      String?   @db.Text

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  coupon     Coupon?    @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([status, provider])
  @@map("payments")
}

model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  // Relations
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id       String @id @default(uuid()) @db.Uuid
  cartId   String @db.Uuid
  courseId String @db.Uuid

  // Relations
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([cartId, courseId])
  @@map("cart_items")
}

model Wishlist {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  courseId String @db.Uuid

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("wishlists")
}

// Singleton platform settings (one row, id = "app"). Editable by admins and
// read by the registration guard, maintenance gate, payment auto-approve, and
// the KYC gate.
model AppSetting {
  id                  String   @id @default("app")
  siteName            String   @default("212 Learn")
  supportEmail        String   @default("support@212learn.com")
  currency            String   @default("MAD")
  wafacashAutoApprove Boolean  @default(false)
  requireKyc          Boolean  @default(true)
  allowRegistrations  Boolean  @default(true)
  maintenanceMode     Boolean  @default(false)
  emailNotifications  Boolean  @default(true)
  updatedAt           DateTime @default(now()) @updatedAt

  @@map("app_settings")
}

model Coupon {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)
  discount       Decimal  @db.Decimal(5, 2)
  expirationDate DateTime
  maxUsage       Int      @default(100)
  currentUsage   Int      @default(0)
  isActive       Boolean  @default(true)

  // A null courseId is a global coupon (admin); a set courseId scopes the coupon
  // to that single course. createdById records who created it (admin/instructor).
  courseId    String? @db.Uuid
  createdById String? @db.Uuid

  // Relations
  payments Payment[]
  course   Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@index([createdById])
  @@map("coupons")
}

// ─── Module 5: Quiz & Évaluations (Quiz) ───────────────────────────────────

model Quiz {
  id               String @id @default(uuid()) @db.Uuid
  lessonId         String @db.Uuid
  title            String @db.VarChar(255)
  validationStatus String @db.VarChar(50)

  // Relations
  lesson    Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id            String @id @default(uuid()) @db.Uuid
  quizId        String @db.Uuid
  statement     String @db.Text
  options       Json? // Array of strings: ["Option A", "Option B", "Option C", "Option D"]
  correctAnswer String @db.Text // Must match one of the options exactly

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  quizId      String   @db.Uuid
  userId      String   @db.Uuid
  score       Decimal? @db.Decimal(5, 2)
  duration    Int?
  attemptDate DateTime @default(now())

  // Relations
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("quiz_attempts")
}

// ─── Module 6: Social & Suivi (Social) ──────────────────────────────────────

model LessonProgress {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  lessonId       String    @db.Uuid
  completed      Boolean   @default(false)
  videoCompleted Boolean   @default(false)  // true once the student watched ≥98% of the lesson video
  videoPosition  Int       @default(0)       // last known playback position in seconds (resume point)
  timeSpent      Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lesson_progresses")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  courseId   String   @db.Uuid
  rating     Int      @db.SmallInt
  comment    String?  @db.Text
  reviewDate DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("reviews")
}

model Notification {
  id      String   @id @default(uuid()) @db.Uuid
  userId  String   @db.Uuid
  content String   @db.Text
  isRead  Boolean
  sentAt  DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Module 7: Gamification (Gamif) ──────────────────────────────────────────

model BadgeDefinition {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique @db.VarChar(150)
  description String? @db.Text
  icon        String? @db.VarChar(500)

  // Relations
  userBadges UserBadge[]

  @@map("badge_definitions")
}

model UserBadge {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  badgeDefinitionId String   @db.Uuid
  obtainedAt        DateTime @default(now())

  // Relations
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeDefinition BadgeDefinition @relation(fields: [badgeDefinitionId], references: [id], onDelete: Cascade)

  @@map("user_badges")
}

model Certificate {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  courseId          String   @db.Uuid
  certificateNumber String   @unique @db.VarChar(100)
  issuedAt          DateTime @default(now())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

// ─── Module 8: Sessions Live (Meeting) ───────────────────────────────────────

model Meeting {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @db.Uuid
  title           String   @db.VarChar(255)
  meetingUrl      String   @db.VarChar(500)
  meetingDate     DateTime
  roomName        String?  @db.VarChar(255)
  status          String   @default("SCHEDULED") @db.VarChar(50) // 'SCHEDULED', 'LIVE', 'COMPLETED'
  durationMinutes Int?
  recordingUrl    String?  @db.VarChar(500)

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("meetings")
}

// ─── Module 9: Audit Logs (AuditLog) ─────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String   @db.VarChar(100)
  resource   String   @db.VarChar(100)
  resourceId String?  @db.VarChar(100)
  details    Json?
  createdAt  DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([resource])
  @@map("audit_logs")
}

// ─── Module 10: Groupes de Formation (Group) ────────────────────────────────

model Group {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(150)
  description String?   @db.Text
  courseId    String?   @db.Uuid
  formateurId String    @db.Uuid
  createdById String?   @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Relations
  course       Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  formateur    User               @relation("GroupFormateur", fields: [formateurId], references: [id], onDelete: Restrict)
  createdBy    User?              @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  students     GroupStudent[]
  chatMessages GroupChatMessage[]

  @@map("groups")
}

model GroupStudent {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  // Relations
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_students")
}

// ─── Group Chat Messages ──────────────────────────────────────────────────────

model GroupChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  senderId  String   @db.Uuid
  text      String?  @db.Text
  fileUrl   String?  @db.VarChar(500)
  fileType  String?  @db.VarChar(50) // 'image' | 'video' | 'audio' | 'document' | 'other'
  fileName  String?  @db.VarChar(255)
  status    String   @default("approved") @db.VarChar(50) // 'approved' | 'blocked_ai' | 'deleted'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("group_chat_messages")
}

// ─── Contact Messages ──────────────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  status    String   @default("unread") @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contact_messages")
}

// ─── Packs (bundles of courses at a reduced price) ───────────────────────────
// A pack groups several existing courses under one reduced price. Each course in
// the pack is tied to ONE instructor (chosen by the admin among that course's
// instructors) who earns the revenue for that course. Early-bird pricing:
// the first `launchSeats` buyers pay `launchPrice`, everyone after pays `price`.
model Pack {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  description String?   @db.Text
  thumbnail   String?   @db.VarChar(500)
  price       Decimal   @db.Decimal(10, 2)           // prix normal (après lancement)
  launchPrice Decimal?  @db.Decimal(10, 2)           // prix des premiers inscrits
  launchSeats Int       @default(0)                  // nb de places au prix de lancement
  currency    String    @default("MAD") @db.VarChar(10)
  status      String    @default("draft") @db.VarChar(50) // draft | published | archived
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  courses   PackCourse[]
  purchases PackPurchase[]

  @@index([status, deletedAt])
  @@map("packs")
}

model PackCourse {
  id           String @id @default(uuid()) @db.Uuid
  packId       String @db.Uuid
  courseId     String @db.Uuid
  instructorId String @db.Uuid // formateur (parmi ceux du cours) qui touche le revenu

  pack       Pack   @relation(fields: [packId], references: [id], onDelete: Cascade)
  course     Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor User   @relation("PackCourseInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  @@unique([packId, courseId])
  @@index([courseId])
  @@map("pack_courses")
}

// A student's order for a pack. Mirrors the Payment state machine but at the
// pack level: one purchase → many course enrollments on approval. Kept separate
// from Payment (which is 1:1 with a single-course Enrollment).
model PackPurchase {
  id                   String    @id @default(uuid()) @db.Uuid
  packId               String    @db.Uuid
  userId               String    @db.Uuid
  amount               Decimal   @db.Decimal(10, 2) // prix effectivement facturé (lancement ou normal)
  currency             String    @default("MAD") @db.VarChar(10)
  provider             String    @db.VarChar(50) // 'wafacash' | 'transfer'
  transactionReference String    @unique @db.VarChar(255)
  status               String    @db.VarChar(50) // PENDING | WAITING_VERIFICATION | PAID | REJECTED
  isLaunchPrice        Boolean   @default(false) // ce acheteur a-t-il eu une place de lancement ?

  // Wafacash
  mtcn       String? @db.VarChar(50)
  receiptUrl String? @db.VarChar(500)
  // Bank transfer
  rib                String? @db.VarChar(50)
  transferReceiptUrl String? @db.VarChar(500)
  // Verification
  verifiedBy String?   @db.Uuid
  verifiedAt DateTime?
  notes      String?   @db.Text
  paidAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pack          Pack           @relation(fields: [packId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  revenueShares RevenueShare[]

  @@index([status, provider])
  @@index([packId])
  @@index([userId])
  @@map("pack_purchases")
}

// Accounting ledger: what each instructor is owed for a pack purchase after the
// platform commission. Payouts are manual — `status` moves pending → paid_out.
model RevenueShare {
  id               String  @id @default(uuid()) @db.Uuid
  packPurchaseId   String  @db.Uuid
  packId           String  @db.Uuid
  courseId         String  @db.Uuid
  instructorId     String  @db.Uuid
  grossAmount      Decimal @db.Decimal(10, 2) // part du prix (prix pack / nb cours)
  commissionPct    Decimal @db.Decimal(5, 2)  // 20.00
  commissionAmount Decimal @db.Decimal(10, 2) // commission plateforme
  netAmount        Decimal @db.Decimal(10, 2) // dû au formateur (gross - commission)
  currency         String  @default("MAD") @db.VarChar(10)
  status           String  @default("pending") @db.VarChar(50) // pending | paid_out
  paidOutAt        DateTime?
  createdAt        DateTime @default(now())

  packPurchase PackPurchase @relation(fields: [packPurchaseId], references: [id], onDelete: Cascade)
  course       Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructor   User         @relation("RevenueShareInstructor", fields: [instructorId], references: [id], onDelete: Restrict)

  @@index([instructorId, status])
  @@index([packId])
  @@index([packPurchaseId])
  @@map("revenue_shares")
}
