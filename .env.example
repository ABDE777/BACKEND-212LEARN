# Server
PORT=5000
NODE_ENV=development

# Database seed (local/dev only — `npm run prisma:seed` WIPES all data).
# Admin password is never a hardcoded default: set one here, or a strong random
# one is generated and printed once. The seed refuses to run when NODE_ENV=production
# unless SEED_FORCE=true.
# SEED_ADMIN_EMAIL=admin@212learn.com
# SEED_ADMIN_PASSWORD=change-me-strong
# SEED_TEST_PASSWORD=password123
# SEED_FORCE=false

# PostgreSQL (prefer Neon pooled URL on Vercel: ...-pooler..../neondb?sslmode=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT — REQUIRED in production (app will refuse to start auth without it)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Frontend (CORS)
FRONTEND_URL=https://your-frontend-url

# Wafacash (dev only — never enable auto-approve in production)
WAFACASH_AUTO_APPROVE=false

# Bank Transfer (Virement) — bank account information for students
BANK_RIB="01178000011800000000123456"
BANK_IBAN="MA89 0117 8000 0118 0000 0000 1234 56"
BANK_SWIFT="CWBAMAMM"
# dev only — never enable auto-approve in production
TRANSFER_AUTO_APPROVE=false

# Groq (AI quiz generation)
GROQ_API_KEY=your-groq-api-key

# Optional: shared rate limiting on Vercel (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# Optional production flags
# ENABLE_API_DOCS=true                 # expose /api-docs in production
# ALLOW_UNLIMITED_PAGINATION=true      # allow limit=-1 / 0 in production

# Email (Nodemailer)
EMAIL_MOCK=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM="212Learn <noreply@example.com>"

# JaaS (Jitsi as a Service) — video meetings
JAAS_APP_ID="vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
JAAS_API_KEY_ID="vpaas-magic-cookie-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/yyyyyy"
# Paste the PEM with literal \n between lines (Vercel env vars can't hold real newlines);
# the code below converts \n back to real newlines at runtime.
JAAS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIJ...\n-----END PRIVATE KEY-----\n"
JAAS_DOMAIN="8x8.vc"
# Optional, for verifying recording webhooks
JAAS_WEBHOOK_SECRET="replace-with-a-long-random-secret"
