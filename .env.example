# Server Port
PORT=5000

# Environment
NODE_ENV=development

# Neon Database URL
DATABASE_URL="postgresql://username:password@hostname/dbname?sslmode=require"

# Database Connection URL (PostgreSQL example)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/212learning?schema=public"


# JWT Configuration
JWT_SECRET="your-jwt-secret-key-here"
JWT_EXPIRES_IN="7d"

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"


# Frontend Application URL
FRONTEND_URL=https://your-fronted-link

# Wafacash Simulation (For academic presentation / soutenance)
WAFACASH_AUTO_APPROVE=false # Set to false to require manual validation by default (demo=true parameter still works in dev)


GEMINI_API_KEY=your-api-key

# ── Email (Nodemailer) ─────────────────────────────────────────────────────────
# Set EMAIL_MOCK=true in development to skip real sending (logs to console instead)
EMAIL_MOCK=true

# For production, use your real SMTP credentials (e.g. Gmail, SendGrid, Brevo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=212learn.support@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM="212Learn <212learn.support@gmail.com>"