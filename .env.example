# Server
PORT=5000
NODE_ENV=development

# PostgreSQL (prefer Neon pooled URL on Vercel: ...-pooler..../neondb?sslmode=require)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT — REQUIRED in production (app will refuse to start auth without it)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Cloudinary
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Frontend (CORS)
FRONTEND_URL=https://your-frontend-url

# Wafacash (dev only — never enable auto-approve in production)
WAFACASH_AUTO_APPROVE=false

# Bank Transfer (Virement) — bank account information for students
BANK_RIB="01178000011800000000123456"
BANK_IBAN="MA89 0117 8000 0118 0000 0000 1234 56"
BANK_SWIFT="CWBAMAMM"
# dev only — never enable auto-approve in production
TRANSFER_AUTO_APPROVE=false

# Groq (AI quiz generation)
GROQ_API_KEY=your-groq-api-key

# Optional: shared rate limiting on Vercel (Upstash Redis REST)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxx

# Optional production flags
# ENABLE_API_DOCS=true                 # expose /api-docs in production
# ALLOW_UNLIMITED_PAGINATION=true      # allow limit=-1 / 0 in production

# Email (Nodemailer)
EMAIL_MOCK=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-password
EMAIL_FROM="212Learn <noreply@example.com>"

# Video meetings — MiroTalk SFU (self-hosted, no active-user/month cap)
# Base URL of your MiroTalk SFU server. Leave empty to use the public MiroTalk
# demo instance (fine for testing; self-host for production).
MIROTALK_URL="https://sfu.mirotalk.com"

# ── Legacy Jitsi/JaaS (no longer used; meetings run on MiroTalk) ──
# Kept only so old deploys don't break; safe to remove.
# JAAS_APP_ID=""
# JAAS_API_KEY_ID=""
# JAAS_PRIVATE_KEY=""
# JAAS_DOMAIN="8x8.vc"
# JAAS_WEBHOOK_SECRET=""
