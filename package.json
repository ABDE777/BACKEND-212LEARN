{
  "name": "212learn-backend",
  "version": "1.0.0",
  "description": "Backend API for 212Learning Platform",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "node prisma/seed.js",
    "db:clean": "node prisma/clean-db.js",
    "db:create-admins": "node prisma/create-admins.js",
    "db:create-demo": "node prisma/create-demo-data.js",
    "db:check": "node scripts/db-check.js",
    "db:setup": "prisma generate && prisma migrate deploy && node prisma/seed.js",
    "db:reset": "prisma migrate reset --force",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/coupon.test.js tests/unit/validation.test.js tests/unit/jwt.test.js tests/unit/cloudinary.test.js tests/unit/registration.test.js tests/unit/groupSync.test.js tests/unit/portfolio.test.js tests/unit/pack.test.js",
    "test:integration": "node tests/integration/run.js",
    "test:sprint6": "node test/sprint6_test.js",
    "test:sprint7": "node test/sprint7_test.js",
    "test:sprint8": "node test/sprint8_test.js",
    "test:security": "node test/security_regression_tests.js",
    "test:quiz": "node test/quiz_test.js",
    "test:commerce": "node tests/integration/commerce.test.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.11",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.11.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^7.8.0"
  }
}
